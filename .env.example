# Copy to .env (never commit .env). All values required unless noted.

# Qdrant cluster (1536-dim, cosine). Keep the URL private in public repos.
QIP_QDRANT_URL=https://YOUR-CLUSTER.cloud.qdrant.io
QIP_QDRANT_API_KEY=

# OpenAI, embeddings only. Canonical model is enforced fail-closed.
OPENAI_API_KEY=

# Agent identity for provenance + Mesh signing
QIP_AGENT_ID=fable5
QIP_AGENT_KEY=change-me-per-agent-hmac-secret

# Default project stamp for writes
QIP_PROJECT=QIP-CORE

# Optional: trust threshold for adopting Mesh principles (default 0.6)
QIP_TRUST_THRESHOLD=0.6
